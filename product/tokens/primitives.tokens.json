  "app-type": {
    "$description": "Phone and watch type, the web's one voice in apps (mobile.md, watch.md): Archivo for words, its wide cut for titles and section heads, Cascadia Mono for numbers. Sizes are pt on Apple platforms and sp on Android, written as px, and each scales with Dynamic Type or font scaling from its iOS text style (co.fusionspace.ios.textStyle). FusionSpaceColors.swift's FS.title() and the rest and Compose's FsType carry the same values.",
    "phone": {
      "title": {
        "$type": "typography",
        "$description": "A screen's title.",
        "$value": {
          "fontFamily": "{font.wide}",
          "fontSize": {
            "value": 28,
            "unit": "px"
          },
          "lineHeight": 1.1429,
          "fontWeight": 600,
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          }
        },
        "$extensions": {
          "co.fusionspace": {
            "textCase": "none",
            "ios": {
              "textStyle": "title"
            }
          }
        }
      },
      "heading": {
        "$type": "typography",
        "$description": "A section's head, under its 2 pt rule.",
        "$value": {
          "fontFamily": "{font.wide}",
          "fontSize": {
            "value": 18,
            "unit": "px"
          },
          "lineHeight": 1.3333,
          "fontWeight": 600,
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          }
        },
        "$extensions": {
          "co.fusionspace": {
            "textCase": "none",
            "ios": {
              "textStyle": "headline"
            }
          }
        }
      },
      "label": {
        "$type": "typography",
